{
  "name": "krusch-pre-router",
  "version": "1.0.0",
  "description": "Deterministic Regex Fast-Path Pre-Router & In-Memory Memoization Table for LLM Swarms. Intercepts structured code, SQL, math, and closed-world queries in CPU microseconds (<15µs) for $0.00.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "pretest": "npm run build",
    "test": "node --test",
    "prebench": "npm run build",
    "bench": "node benchmark/latency.bench.js",
    "harvest:ood": "node scripts/harvest-ood.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "llm",
    "router",
    "pre-router",
    "memoization",
    "cache",
    "fast-path",
    "ai-agent",
    "agentic-routing",
    "classifier",
    "heuristic",
    "openrouter",
    "prompt-routing"
  ],
  "author": "Kevin Krusch",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kruschdev/krusch-pre-router.git"
  },
  "bugs": {
    "url": "https://github.com/kruschdev/krusch-pre-router/issues"
  },
  "homepage": "https://github.com/kruschdev/krusch-pre-router#readme",
  "devDependencies": {
    "@types/node": "^20.19.33",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
